{
  "name": "boundfoxstudios.com",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:en": "ng serve --configuration=en",
    "preview": "npm run build && http-server dist/website/browser -p 4300 -c-1",
    "preview:de": "ng build --configuration development && http-server dist/website/browser -p 4300 -c-1",
    "preview:draft": "npm run build:draft && http-server dist/website/browser -p 4300 -c-1",
    "fetch:github": "node tools/fetch-github-data.mjs projects/website/src/app/generated/github-data.json",
    "fonts:generate": "node tools/generate-fonts.mjs",
    "images:generate": "node tools/generate-images.mjs",
    "images:crops": "node tools/generate-bug-a-ball-crops.mjs",
    "generate:icons": "node tools/seo/generate-icons.mjs",
    "prebuild": "npm run fetch:github",
    "build": "ng build",
    "postbuild": "node tools/seo/finalize-dist.mjs && node tools/seo/generate-sitemap.mjs",
    "build:draft": "ng build --i18n-missing-translation=warning",
    "i18n:extract": "ng extract-i18n",
    "i18n:check": "ng extract-i18n && git diff --exit-code -- projects/website/src/locale && node tools/verify-translations.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test && vitest run --config vitest.config.mts",
    "check:viewports": "node tools/check-viewports.mjs",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "axe": "node tools/a11y/run-axe.mjs",
    "verify:translations": "node tools/verify-translations.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "lefthook install"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true,
    "lefthook": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "playwright": true
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/ssr": "^22.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/localize": "^22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "http-server": "14.1.1",
    "jsdom": "^30.1.2",
    "lefthook": "^2.1.16",
    "ng-extract-i18n-merge": "^3.4.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-css-order": "~2.2.0",
    "prettier-plugin-organize-attributes": "~1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "tmp": "^0.2.5"
  }
}
