Options -Indexes -MultiViews
DirectorySlash On
DirectoryIndex index.html
AddDefaultCharset utf-8
ServerSignature Off

ErrorDocument 404 /404/index.html

# No HTTPS rewrite and no Strict-Transport-Security here: both are enforced at Cloudflare. Behind
# the proxy a `RewriteCond %{HTTPS} !=on` is an infinite redirect loop, and HSTS set at two layers
# is a footgun. Routing needs no rewrites either — every route is a directory with an index.html.

<IfModule mime_module>
  AddType application/manifest+json webmanifest
  AddCharset utf-8 .css .html .js .json .svg .txt .webmanifest .xml
</IfModule>

# Exactly one compression filter ends up running. Apache does not negotiate between them, it chains
# them, and distributions register a global `AddOutputFilterByType DEFLATE` of their own — so
# without the `no-gzip` flag a response would be brotli-encoded and then gzipped on top. The flag
# is set only for clients that actually announce br, which leaves gzip for everyone else.
<IfModule brotli_module>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
  SetEnvIfNoCase Accept-Encoding "br" no-gzip=1
</IfModule>
<IfModule !brotli_module>
  <IfModule deflate_module>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
  </IfModule>
</IfModule>

<IfModule headers_module>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always unset X-Powered-By

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The fonts are copied verbatim from public/ and keep a stable name, so they cannot be immutable
  # the way the content-hashed bundles can — a re-subset would otherwise stay invisible for a year.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(avif|gif|ico|jpe?g|png|svg|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # After the .txt rule on purpose, because it overrides it: the deploy workflow polls this marker
  # to learn when the new build is actually being served, so it must never come from a cache.
  <FilesMatch "^build-id\.txt$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Narrowed to `^\.ht` rather than every dotfile so that /.well-known/security.txt stays reachable.
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>
